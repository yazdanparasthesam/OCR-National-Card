# ── nidocr configuration ─────────────────────────────────────────────
# Every variable maps to nidocr.config.Settings (prefix NIDOCR_).
# Copy to .env and edit; `nidocr doctor` prints the effective values.

# Tesseract binary. Empty -> auto-detect (PATH, /usr/bin, /usr/local/bin, bundled).
NIDOCR_TESSERACT_CMD=
# Folder that contains fas.traineddata (defaults to ./models/tessdata).
NIDOCR_TESSDATA_DIR=
# Comma separated tesseract languages, e.g. "fas" or "fas,eng".
NIDOCR_LANGUAGES=fas
NIDOCR_OEM=1

# ── OCR tuning ───────────────────────────────────────────────────────
NIDOCR_PASSES=3                 # preprocessing variants voted per field
NIDOCR_UPSCALE=3.0              # ROI upscale factor before OCR
NIDOCR_MIN_CONFIDENCE=45.0      # below this a field is flagged as low confidence
NIDOCR_USE_LABEL_ANCHORS=true   # detect field labels with OCR, fall back to template ROIs
NIDOCR_ANCHOR_MIN_SIMILARITY=0.66
NIDOCR_CACHE_OCR=true           # cache OCR results per image hash

# ── names ────────────────────────────────────────────────────────────
NIDOCR_USE_NAME_LEXICON=true    # snap OCR names to the lexicon (dotted-letter errors)
# Folder with first_names.txt / last_names.txt (defaults to ./data/lexicon).
# Point it at a civil-registry list for production accuracy.
NIDOCR_LEXICON_DIR=

# ── card geometry ────────────────────────────────────────────────────
NIDOCR_DEFAULT_TEMPLATE=national_card_front
NIDOCR_TEMPLATE_DIR=            # defaults to ./nidocr/templates
NIDOCR_CANONICAL_WIDTH=1012
NIDOCR_CANONICAL_HEIGHT=638
NIDOCR_CARD_ASPECT=1.5857
NIDOCR_MAX_IMAGE_SIDE=2400

# ── validation ───────────────────────────────────────────────────────
NIDOCR_BIRTH_YEAR_MIN=1200
NIDOCR_BIRTH_YEAR_MAX=1450

# ── API ──────────────────────────────────────────────────────────────
NIDOCR_API_PREFIX=/api/v1
NIDOCR_CORS_ORIGINS=["*"]
NIDOCR_MAX_UPLOAD_MB=12
NIDOCR_LOG_LEVEL=INFO

# ── UI -> API wiring (optional; the UI also works fully in-process) ──
NIDOCR_API_URL=http://127.0.0.1:8000
